{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qgate.internal/schemas/config.schema.json",
  "title": "qgate config",
  "description": "A qgate config layer (builtin defaults, org config or repo config). Fields marked \"x-qgate-interpolate\": true accept ${VAR} environment interpolation; no other field does.",
  "$ref": "#/$defs/layer",
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "const": 1 },
        "locked": {
          "description": "Org config only: dotted paths into the resolved config that no later layer may change.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_-]+)*$" }
        },
        "org_config_sha256": {
          "description": "Repo config only: the SHA-256 the org config must have.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "project": { "$ref": "#/$defs/project" },
        "scoring": { "$ref": "#/$defs/scoring" },
        "llm": { "$ref": "#/$defs/llm" },
        "providers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/provider" } },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "category_mappings": { "type": "array", "items": { "$ref": "#/$defs/categoryMapping" } },
        "agents": { "type": "object", "additionalProperties": { "$ref": "#/$defs/agent" } },
        "review_rules": { "type": "array", "items": { "$ref": "#/$defs/reviewRule" } },
        "suppressions": { "type": "array", "items": { "$ref": "#/$defs/suppression" } },
        "baseline": { "$ref": "#/$defs/baseline" },
        "profiles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/profile" } },
        "reporting": { "$ref": "#/$defs/reporting" }
      }
    },
    "resolved": {
      "description": "A config after layering, profile resolution and --set: profiles are replaced by the selected stage and its resolved profile.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "stage", "profile"],
      "properties": {
        "version": { "const": 1 },
        "stage": { "$ref": "#/$defs/name" },
        "profile": { "$ref": "#/$defs/resolvedProfile" },
        "project": { "$ref": "#/$defs/project" },
        "scoring": { "$ref": "#/$defs/scoring" },
        "llm": { "$ref": "#/$defs/llm" },
        "providers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/provider" } },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "category_mappings": { "type": "array", "items": { "$ref": "#/$defs/categoryMapping" } },
        "agents": { "type": "object", "additionalProperties": { "$ref": "#/$defs/agent" } },
        "review_rules": { "type": "array", "items": { "$ref": "#/$defs/reviewRule" } },
        "suppressions": { "type": "array", "items": { "$ref": "#/$defs/suppression" } },
        "baseline": { "$ref": "#/$defs/baseline" },
        "reporting": { "$ref": "#/$defs/reporting" }
      }
    },

    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "envVarName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "glob": { "type": "string", "minLength": 1 },
    "globs": { "type": "array", "items": { "$ref": "#/$defs/glob" } },
    "duration": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "nonNegativeInt": { "type": "integer", "minimum": 0 },
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 },

    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "include": { "$ref": "#/$defs/globs" },
        "exclude": { "$ref": "#/$defs/globs" }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "severity_weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "info": { "$ref": "#/$defs/nonNegativeInt" },
            "low": { "$ref": "#/$defs/nonNegativeInt" },
            "medium": { "$ref": "#/$defs/nonNegativeInt" },
            "high": { "$ref": "#/$defs/nonNegativeInt" },
            "critical": { "$ref": "#/$defs/nonNegativeInt" }
          }
        },
        "agent_weight_pct": { "$ref": "#/$defs/percent" },
        "agent_min_confidence": { "$ref": "#/$defs/percent" },
        "agent_max_penalty": { "type": "integer", "minimum": 0, "maximum": 100 },
        "category_weights": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/category" },
          "additionalProperties": { "$ref": "#/$defs/nonNegativeInt" }
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_providers": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "redact_secrets": { "type": "boolean" },
        "redact_patterns": { "type": "array", "items": { "type": "string" } },
        "exclude_paths": { "$ref": "#/$defs/globs" },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_input_tokens_per_run": { "$ref": "#/$defs/nonNegativeInt" },
            "max_units_per_agent": { "$ref": "#/$defs/nonNegativeInt" }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["anthropic", "openai", "azure_openai", "openai_compatible"] },
        "api_key_env": { "$ref": "#/$defs/envVarName" },
        "base_url": { "type": "string", "x-qgate-interpolate": true },
        "api_version": { "type": "string" },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "request_timeout": { "$ref": "#/$defs/duration" },
        "fallback": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*/.+$" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context_window": { "type": "integer", "minimum": 1 },
            "json_schema": { "type": "boolean" },
            "tool_calls": { "type": "boolean" }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_per_mtok": { "type": "number", "minimum": 0 },
            "output_per_mtok": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "mode": { "enum": ["import", "run", "exec_plugin"] },
        "format": { "enum": ["sarif", "checkstyle", "cobertura", "lcov", "junit", "json_mapping"] },
        "path": { "type": "string", "x-qgate-interpolate": true },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "x-qgate-interpolate": true } },
        "timeout": { "$ref": "#/$defs/duration" },
        "env": { "type": "array", "items": { "$ref": "#/$defs/envVarName" } },
        "required": { "type": "boolean" },
        "category_default": { "$ref": "#/$defs/category" },
        "assesses": { "type": "array", "items": { "$ref": "#/$defs/category" } },
        "severity_map": { "type": "object", "additionalProperties": { "$ref": "#/$defs/severity" } },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items", "rule_id", "message", "path"],
          "properties": {
            "items": { "type": "string" },
            "rule_id": { "type": "string" },
            "message": { "type": "string" },
            "title": { "type": "string" },
            "path": { "type": "string" },
            "start_line": { "type": "string" },
            "end_line": { "type": "string" },
            "severity": { "type": "string" }
          }
        },
        "options": { "type": "object" }
      }
    },
    "categoryMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "category"],
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "cwe": { "type": "string" },
            "rule_id": { "$ref": "#/$defs/glob" },
            "path": { "$ref": "#/$defs/glob" }
          }
        },
        "category": { "$ref": "#/$defs/category" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "model", "prompt"],
      "properties": {
        "kind": { "enum": ["reviewer", "triager"] },
        "provider": { "$ref": "#/$defs/name" },
        "model": { "type": "string", "minLength": 1 },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base"],
          "properties": {
            "base": { "type": "string", "minLength": 1 },
            "extend": { "type": "array", "items": { "type": "string" } }
          }
        },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
        "max_findings_per_unit": { "type": "integer", "minimum": 1 },
        "max_severity": { "$ref": "#/$defs/severity" },
        "priority_paths": { "$ref": "#/$defs/globs" },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min_severity": { "$ref": "#/$defs/severity" } }
        },
        "include_full_file": { "type": "boolean" },
        "context_lines": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "reviewRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "severity", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "category": { "$ref": "#/$defs/category" },
        "paths": { "$ref": "#/$defs/globs" },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/name" } }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "reason"],
      "properties": {
        "rule": { "$ref": "#/$defs/glob" },
        "paths": { "$ref": "#/$defs/globs" },
        "reason": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "path": { "type": "string", "x-qgate-interpolate": true } }
    },
    "errorPolicy": { "enum": ["warn", "fail"] },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overall_min": { "$ref": "#/$defs/percent" },
        "category_min": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/category" },
          "additionalProperties": { "$ref": "#/$defs/percent" }
        },
        "max_new": { "$ref": "#/$defs/severityCounts" },
        "max_new_tool": { "$ref": "#/$defs/severityCounts" },
        "require_assessed": { "type": "array", "items": { "$ref": "#/$defs/category" } },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "op", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "pattern": "^(diff|repo|file:.+)$" },
              "op": { "enum": [">=", ">", "<=", "<", "==", "!="] },
              "value": { "type": "number" },
              "optional": { "type": "boolean" }
            }
          }
        }
      }
    },
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "info": { "$ref": "#/$defs/nonNegativeInt" },
        "low": { "$ref": "#/$defs/nonNegativeInt" },
        "medium": { "$ref": "#/$defs/nonNegativeInt" },
        "high": { "$ref": "#/$defs/nonNegativeInt" },
        "critical": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "enforcement": { "enum": ["advisory", "blocking"] },
    "gatingScope": { "enum": ["diff", "files", "repo"] },
    "profile": {
      "description": "Keep the properties in step with resolvedProfile, which adds no extends and requires every field.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": { "$ref": "#/$defs/name" },
        "enforcement": { "$ref": "#/$defs/enforcement" },
        "scope": { "$ref": "#/$defs/gatingScope" },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "on_input_error": { "$ref": "#/$defs/errorPolicy" },
        "on_agent_error": { "$ref": "#/$defs/errorPolicy" },
        "agent_context_findings": { "type": "boolean" },
        "gate": { "$ref": "#/$defs/gate" }
      }
    },
    "resolvedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement", "scope", "agents", "on_input_error", "on_agent_error", "gate"],
      "properties": {
        "enforcement": { "$ref": "#/$defs/enforcement" },
        "scope": { "$ref": "#/$defs/gatingScope" },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "on_input_error": { "$ref": "#/$defs/errorPolicy" },
        "on_agent_error": { "$ref": "#/$defs/errorPolicy" },
        "agent_context_findings": { "type": "boolean" },
        "gate": { "$ref": "#/$defs/gate" }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": { "type": "boolean" },
            "inline": { "type": "boolean" },
            "inline_min_severity": { "$ref": "#/$defs/severity" },
            "max_inline_comments": { "$ref": "#/$defs/nonNegativeInt" },
            "platform": { "enum": ["github", "gitlab"] },
            "api_url": { "type": "string", "x-qgate-interpolate": true }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "path"],
            "properties": {
              "format": { "enum": ["json", "sarif", "markdown"] },
              "path": { "type": "string", "x-qgate-interpolate": true }
            }
          }
        }
      }
    }
  }
}
