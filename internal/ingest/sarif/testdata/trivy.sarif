            {
              "id": "CVE-2026-78669",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "net/http: net/http/internal/http2: golang.org/x/net/http2: net/http: Denial of Service via excessive HTTP/2 SETTINGS frames"
              },
              "fullDescription": {
                "text": "A malicious HTTP/2 peer can cause excessive CPU consumption in the client or server by opening a large number of streams and then sending many small SETTINGS frames containing SETTINGS_INITIAL_WINDOW_SIZE values."
