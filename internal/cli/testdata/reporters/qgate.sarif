{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "lint",
          "version": "1.2.3",
          "rules": [
            {
              "id": "lint:unused",
              "shortDescription": {
                "text": "title of unused"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "quality"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "lint:unused",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "message for unused"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "new.go"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 2
                }
              }
            }
          ],
          "partialFingerprints": {
            "qgate/v1": "3d9d3498820136c812a901a55bdd7441aa3da84363c987d10ca43e457d50f897"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "version": "1.2.3",
          "rules": [
            {
              "id": "semgrep:sqli",
              "shortDescription": {
                "text": "title of sqli"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "CWE-89"
                ]
              }
            },
            {
              "id": "semgrep:weak-hash",
              "shortDescription": {
                "text": "title of weak-hash"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "semgrep:todo",
              "shortDescription": {
                "text": "title of todo"
              },
              "properties": {
                "security-severity": "2.0",
                "tags": [
                  "security"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "semgrep:sqli",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "message for sqli"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "a.go"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 5
                }
              }
            }
          ],
          "partialFingerprints": {
            "qgate/v1": "8e6d4c80bd0849487cc0ff1f9c4daebfeaa2dc3ea8bd5db6e94cc00d06104ebf"
          }
        },
        {
          "ruleId": "semgrep:todo",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "message for todo"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "new.go"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "qgate/v1": "c24a1c44113f36cb4bbd23f7c72bf523f7924bd7c1721f8c9342b80923e0ffd9"
          }
        },
        {
          "ruleId": "semgrep:weak-hash",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "message for weak-hash"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "a.go"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 5
                }
              }
            }
          ],
          "partialFingerprints": {
            "qgate/v1": "99d32404529116ede30ef01c8c904455b7207f5b3484b6391414ceb90528f011"
          }
        }
      ]
    }
  ]
}
